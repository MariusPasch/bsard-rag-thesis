# Copy this file to .env.local (gitignored) and fill in as needed.
# Nothing here is committed; never paste real secrets into a tracked file.
# This project builds the corpus and talks only to the Hugging Face Hub —
# there are no LLM/API keys to configure.

# ── Companion Hugging Face dataset ────────────────────────────────────────────
# scripts/download_from_hf.py pulls the corpus/ subset of the combined dataset.
# Override the repo id here (default is the combined thesis dataset).
# BSARD_HF_REPO=Marios-Paschalidis-Thesis/bsard-rag-thesis-data
# Legacy upload target for scripts/upload_to_hf.py (old standalone corpus dataset):
# the combined dataset is populated via the repo-root data_tooling/upload_combined_hf.py.

# Write token (only needed to UPLOAD via scripts/upload_to_hf.py).
# Prefer `hf auth login`; set this only for non-interactive runs.
# HF_TOKEN=

# ── Optional: redirect the Hugging Face cache off the system drive ────────────
# HF_HOME=/absolute/path/to/hf_cache
