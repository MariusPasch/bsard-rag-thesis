# Copy to .env.local (gitignored) and fill in as needed. Nothing here is
# committed; never paste real secrets into a tracked file.
#
# Each component also has its own .env.example with component-specific keys
# (API keys, BSARD_DB paths, etc.). This top-level file covers the shared
# Hugging Face data wiring for the combined dataset.

# ── Combined Hugging Face dataset ─────────────────────────────────────────────
# The single dataset that holds all subsets (corpus/ rq1/ rq2/).
# BSARD_HF_COMBINED_REPO=mpaschalidis/bsard-rag-thesis-data

# Point each component's downloader at the combined dataset:
# BSARD_HF_REPO=mpaschalidis/bsard-rag-thesis-data   # corpus + rq1 + rq3
# RQ2_HF_REPO=mpaschalidis/bsard-rag-thesis-data     # rq2

# ── Local data roots (for upload_combined_hf.py / each component) ─────────────
# Where each subset's artefacts live locally. Leave unset to use the in-repo
# default data root under each component.
# CORPUS_DATA_DIR=/absolute/path/to/corpus_output
# BSARD_DATA_DIR=/absolute/path/to/rq1_output
# RQ2_DATA_DIR=/absolute/path/to/rq2_data

# ── Hugging Face auth (only needed to UPLOAD) ─────────────────────────────────
# Prefer `huggingface-cli login`; set this only for non-interactive runs.
# HF_TOKEN=
