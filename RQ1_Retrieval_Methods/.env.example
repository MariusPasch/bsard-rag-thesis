# Copy this file to .env.local (gitignored) and fill in as needed.
# Nothing here is committed; never paste real secrets into a tracked file.

# ── Data location ─────────────────────────────────────────────────────────────
# Where the large data bundle (corpus DB, parquet, embeddings, results) lives.
# Leave unset to use the default <repo>/output directory.
# BSARD_DATA_DIR=/absolute/path/to/bsard_data

# Combined HF dataset repo id used by scripts/download_data.py (pulls the rq1/ subset).
# BSARD_HF_REPO=mpaschalidis/bsard-rag-thesis-data

# ── API keys (only needed for the LLM-based tiers: Tier 4.x / RQ3) ────────────
# OpenAI key for GPT-4o / gpt-4o-mini judge and HyDE experiments.
# OPENAI_API_KEY=sk-...

# ── Optional: redirect the Hugging Face model cache off the system drive ──────
# HF_HOME=/absolute/path/to/hf_models

# ── Cloud (only if reproducing the Azure GPU notebooks under azure_notebooks/) ─
# GITHUB_TOKEN=                 # PAT used by the notebook to clone this repo
# AZURE_CONTAINER_SAS_URL=      # Blob SAS URL for staging artefacts
