# Copy this file to .env.local (gitignored) and fill in as needed.
# Nothing here is committed; never paste real secrets into a tracked file.

# ── Data location ─────────────────────────────────────────────────────────────
# Where the data bundle (corpus DB, AzureDI exports, per-arm indices, results)
# is downloaded to. Leave unset to use the default <repo>/data directory.
# RQ2_DATA_DIR=/absolute/path/to/rq2_data

# Combined HF dataset repo id used by scripts/download_data.py (pulls the rq2/ subset).
# RQ2_HF_REPO=Marios-Paschalidis-Thesis/bsard-rag-thesis-data

# Path to the BSARD corpus SQLite DB. Defaults to <RQ2_DATA_DIR>/bsard_corpus.db.
# RQ2_BSARD_DB=/absolute/path/to/bsard_corpus.db

# ── LLM access (only for the agentic Arm 2C / PageIndex LLM navigation) ────────
# OPENAI_API_KEY=sk-...
# Ollama endpoint if running local models (default http://localhost:11434).
# OLLAMA_HOST=http://localhost:11434

# ── Optional: redirect the Hugging Face model cache off the system drive ───────
# HF_HOME=/absolute/path/to/hf_models

# ── Cloud (only if reproducing the Azure GPU notebooks) ───────────────────────
# Used by RQ2_T04/notebooks, RQ2_T05/notebooks and experiments/arm2c notebooks.
# GITHUB_TOKEN=                 # PAT used by the notebook to clone the repo
# AZURE_CONTAINER_SAS_URL=      # Blob SAS URL for staging artefacts
